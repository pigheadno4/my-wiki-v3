    {
      "update_id": "billing-subscriptions-bacs-debit::bacs-subscription-fulfillment",
      "target_path": "wiki/concepts/stripe-bacs-direct-debit.md",
      "old_text": "**Delayed notification** \u2014 do NOT fulfill on `checkout.session.completed` alone. Wait for `checkout.session.async_payment_succeeded` or `invoice.paid`. Bacs notification emails are NOT sent in sandboxes.",
      "new_text": "**Delayed notification** \u2014 `checkout.session.completed` records debit authorization, not payment success. Before fulfillment, verify the related subscription is `active` and wait for `invoice.paid` or a `succeeded` underlying PaymentIntent; `active` alone can precede the first payment. `checkout.session.async_payment_succeeded` reports later payment success, not immediate funds availability. Bacs notification emails are not sent in sandboxes.",
      "reason": "State the explicit November fulfillment gate and distinguish payment success from available funds.",
      "quote_indexes": [
        2
      ],
      "warnings": [],
      "original_update_id": "bacs-subscription-fulfillment",
