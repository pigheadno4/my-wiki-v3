{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metronome model-neutral evidence draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id", "raw_path", "canonical_url", "title", "grounding_quotes",
    "overview", "overview_evidence_quote_ids", "key_takeaways", "details",
    "sections_covered", "scope_boundaries", "conditional_requirements",
    "feature_gates", "internal_inconsistencies", "material_omissions",
    "suggested_tags", "suggested_metronome_concepts", "proposed_raw_link",
    "unsupported_claim_self_check"
  ],
  "$defs": {
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_quote_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence_quote_ids": {
          "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "raw_path": {"type": "string", "pattern": "^raw/metronome/.+\\.md$"},
    "canonical_url": {"type": "string", "pattern": "^https://docs\\.metronome\\.com/"},
    "title": {"type": "string", "minLength": 1},
    "grounding_quotes": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "line_start", "line_end", "text", "supports"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "supports": {"type": "string", "minLength": 1}
        }
      }
    },
    "overview": {"type": "string", "minLength": 1},
    "overview_evidence_quote_ids": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    },
    "key_takeaways": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceClaim"}
    },
    "details": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["heading", "facts"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceClaim"}}
        }
      }
    },
    "sections_covered": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scope_boundaries": {"type": "array", "items": {"$ref": "#/$defs/evidenceClaim"}},
    "conditional_requirements": {"type": "array", "items": {"$ref": "#/$defs/evidenceClaim"}},
    "feature_gates": {"type": "array", "items": {"$ref": "#/$defs/evidenceClaim"}},
    "internal_inconsistencies": {"type": "array", "items": {"$ref": "#/$defs/evidenceClaim"}},
    "material_omissions": {"type": "array", "items": {"type": "string"}},
    "suggested_tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "suggested_metronome_concepts": {
      "type": "array", "items": {"type": "string", "pattern": "^metronome-[a-z0-9-]+$"}
    },
    "proposed_raw_link": {"type": "string", "pattern": "^\\[\\[raw/metronome/.+\\|.+\\]\\]$"},
    "unsupported_claim_self_check": {"type": "array", "items": {"type": "string"}}
  }
}
