-
-const paymentMethod = await stripe.paymentMethods.create({
-  type: "card",
-  card: {
-    number: "4242424242424242",
-    exp_month: 11,
-    exp_year: 2026,
-    cvc: "314",
-  },
-  radar_options: {
-    session: "{{RADAR_SESSION_ID}}",
-  },
-});
+```curl
+curl https://api.stripe.com/v1/payment_methods \
+  -u "<<YOUR_SECRET_KEY>>:" \
+  -d type=card \
+  -d "card[number]=4242424242424242" \
