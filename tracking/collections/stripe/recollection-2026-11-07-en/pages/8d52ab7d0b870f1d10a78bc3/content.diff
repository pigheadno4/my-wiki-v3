+  -d "payment_method_data[billing_details][name]={{CUSTOMER_NAME}}" \
+  -d "mandate_data[customer_acceptance][type]=offline" \
+  -d "mandate_data[customer_acceptance][accepted_at]=1692821946"
 ```
 
