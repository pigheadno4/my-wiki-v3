oduct_name: string; product_tags: string[]; rate: { rate_type: 'FLAT' | 'PERCENTAGE' | 'SUBSCRIPTION' | 'CUSTOM' | 'TIERED' | 'TIERED_PERCENTAGE'; credit_type?: credit_type_data; custom_rate?: object; is_prorated?: boolean; price?: number; pricing_group_values?: object; quantity?: number; tiers?: tier[]; }; starting_at: string; billing_frequency?: 'MONTHLY' | 'QUARTERLY' | 'ANNUAL' | 'WEEKLY'; commit_rate?: { rate_type: 'FLAT' | 'PERCENTAGE' | 'SUBSCRIPTION' | 'TIERED' | 'TIERED_PERCENTAGE' | 'CUSTOM'; price?: number; tiers?: tier[]; }; ending_before?: string; pricing_group_values?: object; }`\n\n  - `entitled: boolean`\n  - `product_custom_fields: object`\n  - `product_id: string`\n  - `product_name: string`\n  - `product_tags: string[]`\n  - `rate: { rate_type: 'FLAT' | 'PERCENTAGE' | 'SUBSCRIPTION' | 'CUSTOM' | 'TIERED' | 'TIERED_PERCENTAGE'; credit_type?: { id: string; name: string; }; custom_rate?: object; is_prorated?: boolean; price?: number; pricing_group_values?: object; quantity?: number; tiers?: { price: number; size?: number; }[]; }`\n  - `starting_at: string`\n  - `billing_frequency?: 'MONTHLY' | 'QUARTERLY' | 'ANNUAL' | 'WEEKLY'`\n  - `commit_rate?: { rate_type: 'FLAT' | 'PERCENTAGE' | 'SUBSCRIPTION' | 'TIERED' | 'TIERED_PERCENTAGE' | 'CUSTOM'; price?: number; tiers?: { price: number; size?: number; }[]; }`\n  - `ending_before?: string`\n  - `pricing_group_values?: object`\n\n### Example\n\n```typescript\nimport Metronome from '@metronome/sdk';\n\nconst client = new Metronome();\n\n// Automatically fetches more pages as needed.\nfor await (const rateListResponse of client.v1.contracts.rateCards.rates.list({ at: '2024-01-01T00:00:00.000Z', rate_card_id: 'f3d51ae8-f283-44e1-9933-a3cf9ad7a6fe' })) {\n  console.log(rateListResponse);\n}\n```",
