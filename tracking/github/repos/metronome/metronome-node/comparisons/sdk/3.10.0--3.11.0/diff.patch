g: number; }; entries: { amount: number; created_by: string; credit_grant_id: string; effective_at: string; reason: string; running_balance: number; invoice_id?: string; }[]; pending_entries: { amount: number; created_by: string; credit_grant_id: string; effective_at: string; reason: string; running_balance: number; invoice_id?: string; }[]; starting_balance: { effective_at: string; excluding_pending: number; including_pending: number; }; }[]`\n\n### Example\n\n```typescript\nimport Metronome from '@metronome/sdk';\n\nconst client = new Metronome();\n\n// Automatically fetches more pages as needed.\nfor await (const creditGrantListEntriesResponse of client.v1.creditGrants.listEntries()) {\n  console.log(creditGrantListEntriesResponse);\n}\n```",
