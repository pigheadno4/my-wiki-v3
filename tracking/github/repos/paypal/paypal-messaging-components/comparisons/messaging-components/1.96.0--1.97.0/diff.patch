+ */
+export function disclaimerWrap(breakpoint) {
+    return `@media screen and (max-width: ${breakpoint}px) {
+        .message__disclaimer {
+            white-space: normal;
+        }
+
+        .message__disclaimer > span.tag--large {
+            display: inline-block;
+            min-width: ${breakpoint}px;
+        }
