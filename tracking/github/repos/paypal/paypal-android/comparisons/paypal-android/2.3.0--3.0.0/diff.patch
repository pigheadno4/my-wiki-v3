diff --git a/PayPalPayments/src/main/java/com/paypal/android/paypalpayments/usecase/GetEffectiveReturnUrlConfigUseCase.kt b/PayPalPayments/src/main/java/com/paypal/android/paypalpayments/usecase/GetEffectiveReturnUrlConfigUseCase.kt
