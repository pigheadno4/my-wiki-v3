+ * IMPORTANT: The calling test file must have `jest.mock("./usePayPal")` at the top.
+ */
+export const getMockUsePayPal = (): jest.MockedFunction<typeof usePayPal> =>
+  usePayPal as jest.MockedFunction<typeof usePayPal>;
+
