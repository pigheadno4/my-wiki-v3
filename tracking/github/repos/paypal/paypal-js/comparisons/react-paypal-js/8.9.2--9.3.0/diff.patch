+
+    test("should not error if there is no checkout instance but loading is still pending", () => {
+      mockBraintreePending();
+
+      const {
+        result: {
+          current: { error },
+        },
+      } = renderHook(() =>
+        useBraintreePayPalBillingAgreementSession(defaultProps),
+      );
