+
+  it("should disable the button when disabled=true is given as a prop", () => {
+    const { container } = render(
+      <PayLaterOneTimePaymentButton
+        onApprove={() => Promise.resolve()}
+        orderId="123"
+        presentationMode="auto"
+        disabled={true}
