+import type { LPMComponents, LPMSessionMethodName } from "../types";
+
+export type SessionFieldType =
+  | "phone"
+  | "billingAddress"
+  | "taxInfo"
+  | "expiryDate"
+  | "dateOfBirth"
+  | "numberOfInstallments";
+
+export type LPMFieldType = "name" | "email" | "tax_id" | "tax_id_type";
+
+export interface LPMConfig {
+  readonly component: LPMComponents;
+  readonly buttonTag: string;
+  readonly sessionMethod: LPMSessionMethodName;
+  readonly displayName: string;
+  readonly fields: readonly LPMFieldType[];
+  readonly sessionFields: readonly SessionFieldType[];
+  readonly testBuyerCountry: string;
+}
+
+export const LPM_REGISTRY = {
+  ideal: {
+    component: "ideal-payments",
+    buttonTag: "ideal-button",
+    sessionMethod: "createIdealOneTimePaymentSession",
+    displayName: "iDEAL",
+    fields: ["name"],
+    sessionFields: [],
+    testBuyerCountry: "NL",
+  },
+  bancontact: {
