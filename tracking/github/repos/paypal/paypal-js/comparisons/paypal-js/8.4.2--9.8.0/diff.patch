+  | "label"
+  | "label.disabled"
+  | "label.focus"
+  | "label.invalid"
+  | "label.valid"
+  | "label::placeholder";
+
+export type ValidCssProperties =
+  | "appearance"
+  | "background"
+  | "border"
+  | "borderRadius"
+  | "boxShadow"
+  | "color"
+  | "direction"
+  | "font"
