+   *
+   * @example
+   * ```typescript
+   * const cardFieldsInstance = sdkInstance.createCardFieldsSavePaymentSession();
+   * ```
+   */
+  createCardFieldsSavePaymentSession: () => CardFieldsSavePaymentSession;
+}
