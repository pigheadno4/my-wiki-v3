+      cup: {
+        eligible: true,
+        vaultable: true,
+      },
+    },
+    guestEnabled: false,
+  },
+  venmo: {
+    eligible: false,
+    vaultable: false,
+  },
+  itau: {
+    eligible: false,
+  },
+  credit: {
+    eligible: false,
+  },
+  applepay: {
+    eligible: true,
+  },
+  sepa: {
+    eligible: false,
+  },
+  ideal: {
+    eligible: false,
+  },
+  bancontact: {
+    eligible: false,
+  },
+  giropay: {
