+  verificationMethod?: "SCA_ALWAYS" | "SCA_WHEN_REQUIRED",
+  transactionContext?: Object,
+  idToken?: string,
+|};
+
+// eslint-disable-next-line no-undef
+export type Request = <TRequestData, TResponse>({|
+  method?: string,
+  url: string,
+  // eslint-disable-next-line no-undef
