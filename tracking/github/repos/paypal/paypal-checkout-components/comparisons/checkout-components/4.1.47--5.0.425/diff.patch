+  return {
+    ...DEFAULT_APM_FUNDING_CONFIG,
+
+    layouts: [BUTTON_LAYOUT.HORIZONTAL, BUTTON_LAYOUT.VERTICAL],
+
+    Logo: ({ logoColor, optional }) => {
+      if (__WEB__) {
+        return ItauLogoExternalImage({ logoColor, optional });
+      }
+
+      return ItauLogoInlineSVG({ logoColor, optional });
