+export function dotify(
+  obj: Object,
+  prefix: string = "",
+  newobj: Object = {}
+): { [string]: string } {
+  prefix = prefix ? `${prefix}.` : prefix;
+  for (const key in obj) {
+    if (!obj.hasOwnProperty(key)) {
+      continue;
+    } else if (
+      obj[key] === undefined ||
+      obj[key] === null ||
+      typeof obj[key] === "function"
+    ) {
+      continue;
+    } else if (
+      obj[key] &&
+      Array.isArray(obj[key]) &&
+      obj[key].length &&
+      obj[key].every((val) => typeof val !== "object")
+    ) {
