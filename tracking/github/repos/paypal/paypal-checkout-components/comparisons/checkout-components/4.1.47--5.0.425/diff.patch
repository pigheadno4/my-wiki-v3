+        eligible: false,
+        vaultable: false,
+      },
+      elo: {
+        eligible: false,
+        vaultable: true,
+      },
+      jcb: {
+        eligible: false,
+        vaultable: true,
+      },
+      maestro: {
+        eligible: true,
+        vaultable: true,
+      },
+      diners: {
+        eligible: true,
+        vaultable: true,
