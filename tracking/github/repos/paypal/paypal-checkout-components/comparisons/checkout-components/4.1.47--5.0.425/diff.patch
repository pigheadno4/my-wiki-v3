+      expect(resp).toEqual(response);
+    });
+
+    it("should throw error on error status", async () => {
+      const status = 400;
+      vi.mocked(request).mockResolvedValue({
+        status,
+        body: { message: "Something went wrong" },
+      });
+
+      try {
+        await callGraphQLAPI({
