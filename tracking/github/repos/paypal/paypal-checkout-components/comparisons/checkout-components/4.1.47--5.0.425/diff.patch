+    position: static;
+    visibility: visible;
+`;
+
+export const labelStyle = `
+
+    .${CLASS.BUTTON} .${CLASS.TEXT} {
+        ${HIDDEN}
+    }
+
+    .${CLASS.BUTTON} .${CLASS.TEXT}.${CLASS.IMMEDIATE}:not(.${
+  CLASS.PERSONALIZATION_TEXT
+}):not(.${CLASS.HIDDEN}) {
+        ${VISIBLE}
+        ${EXPANDED}
+    }
+
+    .${CLASS.BUTTON} .${CLASS.VAULT_LABEL} {
+        max-width: 60%;
+        text-overflow: ellipsis;
+        overflow: hidden;
+        white-space: nowrap;
+    }
