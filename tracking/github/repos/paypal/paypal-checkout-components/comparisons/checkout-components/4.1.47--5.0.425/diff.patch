+#!/bin/sh
+
+set -e
+
+# Remove the `dist/` folder; we will re-generate later on
+rm -rf dist/*
+git checkout dist/
+
+# Make sure the HEAD is clean
+if ! git diff-files --quiet; then
+  echo "Can not publish with unstaged uncommited changes"
+  exit 1
+fi
+
+if ! git diff-index --quiet --cached HEAD; then
+  echo "Can not publish with staged uncommited changes"
+  exit 1
+fi
+
+# Re-install just the basics
+modules='@krakenjs/zoid @krakenjs/post-robot @krakenjs/zalgo-promise @krakenjs/beaver-logger @krakenjs/cross-domain-safe-weakmap @krakenjs/cross-domain-utils @krakenjs/belter paypal-braintree-web-client @krakenjs/grumbler-scripts @paypal/sdk-constants'
+
+for module in $modules; do
+  rm -rf "node_modules/$module"
+done
+
+npm install $modules
+npm run build
diff --git a/scripts/publish.sh b/scripts/publish.sh
new file mode 100755
index 00000000..a4f4a3f0
--- /dev/null
+++ b/scripts/publish.sh
@@ -0,0 +1,23 @@
+#!/bin/sh
+
+# This script will determine the type of release based on the git branch.
+# When the default branch is used, it will be a `patch` that's published to npm
+# under the `latest` dist-tag. Any other branch will be a `prelease` that's
+# published to npm under the `alpha-$SHA` dist-tag.
+
+bump='patch'
+tag='latest'
+
+current_branch=$(git rev-parse --abbrev-ref HEAD)
+default_branch=$(git remote show origin | sed -n '/HEAD branch/s/.*: //p')
+current_sha=$(git rev-parse --short HEAD)
+
+if [ "$current_branch" != "$default_branch" ]; then
+  bump='prerelease'
+  tag="alpha-$current_sha"
+  export tag
+  npm --no-git-tag-version version $bump --preid=$tag
+else
+  export tag
+  npm version $bump
+fi
