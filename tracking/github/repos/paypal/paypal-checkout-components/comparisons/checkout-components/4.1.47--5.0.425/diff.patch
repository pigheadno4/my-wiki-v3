-
-function TagLine({ fundingSource, style, locale, multiple, nonce } :
-    {| fundingSource : $Values<typeof FUNDING>, style : ButtonStyle, locale : LocaleType, multiple : boolean, nonce : string |}) : ?ElementNode {
