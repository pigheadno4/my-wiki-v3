+      expect(client.accessToken).toBe(accessToken);
+      expect(client.baseURL).toBe(baseURL);
+    });
+
+    it("should set access token", () => {
+      const client = new HTTPClient();
+      client.setAccessToken(accessToken);
+      expect(client.accessToken).toBe(accessToken);
+    });
