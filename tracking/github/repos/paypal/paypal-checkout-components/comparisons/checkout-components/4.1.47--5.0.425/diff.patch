+/* @flow */
+/** @jsx node */
+/* eslint max-lines: 0 */
+
+import { node, dom } from "@krakenjs/jsx-pragmatic/src";
+import {
+  getLogger,
+  getPayPalDomainRegex,
+  getSDKMeta,
+  getPayPalDomain,
+  getClientID,
+  getUserAccessToken,
+  getClientAccessToken,
+  getUserIDToken,
