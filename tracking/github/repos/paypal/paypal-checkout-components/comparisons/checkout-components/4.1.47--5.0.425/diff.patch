+/* @flow */
+
+import type { ZalgoPromise } from "@krakenjs/zalgo-promise/src";
+import type { CrossDomainWindowType } from "@krakenjs/cross-domain-utils/src";
+import { FUNDING, ENV, type LocaleType } from "@paypal/sdk-constants/src";
+
+import type {
