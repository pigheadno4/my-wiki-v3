+                            padding: 0;
+                            margin: 0;
+                            width: 100%;
+                            height: 100%;
+                            background: rgba(240,240,240,0.5);
+                        }
+
+                        body {
+                            position: relative;
+                            overflow: hidden;
+                        }
+                    `}
+        />
+      </body>
+    </html>
+  );
+}
