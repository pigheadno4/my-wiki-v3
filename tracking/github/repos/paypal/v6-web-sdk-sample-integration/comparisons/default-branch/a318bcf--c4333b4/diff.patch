+async function onPayPalWebSdkLoaded() {
+  try {
+    const clientId = await getBrowserSafeClientId();
+    const sdkInstance = await window.paypal.createInstance({
+      clientId,
+      testBuyerCountry: "NG", // Payattitude testing
+      components: ["payattitude-payments"],
+    });
+
+    // Check if Payattitude is eligible
+    const paymentMethods = await sdkInstance.findEligibleMethods({
+      currencyCode: "NGN",
+    });
+
+    const isPayattitudeEligible = paymentMethods.isEligible("payattitude");
+
+    if (isPayattitudeEligible) {
+      configurePayattitudePayment(sdkInstance);
+    } else {
+      showMessage({
+        text: "Payattitude is not eligible. Please ensure your buyer country is NG and currency is NGN.",
+        type: "error",
+      });
+      console.error("Payattitude is not eligible");
+    }
+  } catch (error) {
+    console.error("Error initializing PayPal SDK:", error);
+    showMessage({
+      text: "Failed to initialize payment system. Please try again.",
+      type: "error",
+    });
+  }
+}
