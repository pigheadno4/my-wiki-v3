+// Get client id from server
+async function getBrowserSafeClientId() {
+  try {
+    const response = await fetch("/paypal-api/auth/browser-safe-client-id", {
+      method: "GET",
+      headers: {
+        "Content-Type": "application/json",
+      },
+    });
+
