--- a/test/unit/braintree/us_bank_account_verification_gateway_spec.js
+++ b/test/unit/braintree/us_bank_account_verification_gateway_spec.js
@@ -321,4 +321,69 @@ describe("UsBankAccountVerificationGateway", () => {
       assert.isFunction(handler);
     });
   });
+
+  describe("path traversal", () => {
+    const traversalIds = [
+      "../../victim_customer/addresses/victim_address",
+      "foo/bar",
+      "foo\\bar",
+      "..%2f..%2fvictim",
+      "..",
+      ".",
+      "%2e%2e",
+      "",
+      "   ",
+      null,
+      123,
+      {},
+    ];
+
+    let httpStubs, traversalGateway;
+
+    beforeEach(() => {
+      httpStubs = {
+        get: sinon.stub(),
+        post: sinon.stub(),
+        put: sinon.stub(),
+        delete: sinon.stub(),
+      };
+      traversalGateway = new UsBankAccountVerificationGateway({
+        config: { baseMerchantPath: () => "/merchants/m" },
+        http: httpStubs,
+      });
+    });
+
+    function assertNotFoundAndNoHttp(promise, stub) {
+      return promise.then(assert.fail).catch((e) => {
+        assert.equal("notFoundError", e.type);
+        assert.isFalse(stub.called);
+      });
+    }
+
+    describe("find", () => {
+      traversalIds.forEach((badId) => {
+        it(`rejects usBankAccountVerificationId ${JSON.stringify(
+          badId
+        )} without calling http`, () => {
+          return assertNotFoundAndNoHttp(
+            traversalGateway.find(badId),
+            httpStubs.get
+          );
+        });
+      });
+    });
+
+    describe("confirmMicroTransferAmounts", () => {
+      traversalIds.forEach((badId) => {
+        it(`rejects usBankAccountVerificationId ${JSON.stringify(
+          badId
+        )} without calling http`, () => {
+          return assertNotFoundAndNoHttp(
+            traversalGateway.confirmMicroTransferAmounts(badId, []),
+            httpStubs.put
+          );
+        });
+      });
+    });
+  });
 });
diff --git a/test/unit/braintree/util_spec.js b/test/unit/braintree/util_spec.js
