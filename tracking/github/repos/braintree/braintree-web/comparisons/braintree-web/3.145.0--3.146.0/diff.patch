--- /dev/null
+++ b/.github/workflows/ci-unit-tests.yml
@@ -0,0 +1,286 @@
+name: "Unit Tests"
+
+on:
+  pull_request:
+    types:
+      - opened
+      - reopened
+      - synchronize
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pull-requests: write
+env:
+  BRAINTREE_JS_ENV: development
+  CI: true
+  HOST: "localhost"
+  COVERAGE_THRESHOLD: 80
+jobs:
+  check-files:
+    uses: ./.github/workflows/check-file-status.yml
+
+  build-test:
+    needs: [check-files]
+    if: needs.check-files.outputs.src_changed == 'True'
+    runs-on: gh-2-core-ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        shardIndex: [1, 2, 3, 4]
+        shardTotal: [4]
+    env:
+      BRAINTREE_JS_ENV: development
+    steps:
+      - uses: actions/checkout@v6
+      - uses: ./.github/actions/setup-node
+
+      - name: "Run tests"
+        run: |
+          npx jest \
+            --config=jest.config.json \
+            --ci \
+            --reporters=summary \
+            --reporters=github-actions \
+            --shard=${{ matrix.shardIndex }}/${{ matrix.shardTotal }} \
+            --coverageThreshold='{}' \
+            --json \
+            --outputFile=test-results.json
+
+      - name: "Upload coverage artifact"
+        uses: actions/upload-artifact@v7
+        with:
+          name: coverage-shard-${{ matrix.shardIndex }}
+          path: src/coverage/coverage-final.json
+          retention-days: 1
+          if-no-files-found: error
+
+      - name: "Upload test results artifact"
+        uses: actions/upload-artifact@v7
+        if: always()
+        with:
+          name: test-results-shard-${{ matrix.shardIndex }}
+          path: test-results.json
+          retention-days: 1
+          if-no-files-found: error
+
+  unit-tests-status:
+    name: "Unit Tests Status"
+    needs: [check-files, build-test]
+    if: always()
+    runs-on: gh-2-core-ubuntu-latest
+    steps:
+      - run: |
+          if [[ "${{ needs.check-files.outputs.src_changed }}" != 'True' ]]; then
+            echo "Skipped - no source changes"
+            exit 0
+          fi
+          if [[ "${{ needs.build-test.result }}" != 'success' ]]; then
+            exit 1
+          fi
+
+  coverage:
+    name: "Coverage Threshold Check"
+    runs-on: gh-2-core-ubuntu-latest
+    needs: [build-test, check-files]
+    if: always() && needs.check-files.outputs.src_changed == 'True' &&
+      needs.build-test.result != 'cancelled'
+    steps:
+      - uses: actions/checkout@v6
+      - uses: ./.github/actions/setup-node
+
+      - name: "Download all coverage artifacts"
+        if: needs.build-test.result == 'success'
+        uses: actions/download-artifact@v8
+        with:
+          pattern: coverage-shard-*
+          path: .nyc_output
+          merge-multiple: false
+
+      - name: "Prepare coverage files for nyc"
+        if: needs.build-test.result == 'success'
+        run: |
+          set -e
+          for dir in .nyc_output/coverage-shard-*/; do
+            shard=$(basename "$dir" | sed 's/coverage-shard-//')
+
+            mv "$dir/coverage-final.json" ".nyc_output/shard-${shard}.json"
+          done
+
+      - name: "Check coverage thresholds"
+        if: needs.build-test.result == 'success'
+        run: |
+          npx nyc check-coverage \
+            --temp-dir .nyc_output \
+            --statements ${{ env.COVERAGE_THRESHOLD }} \
+            --branches ${{ env.COVERAGE_THRESHOLD }} \
+            --functions ${{ env.COVERAGE_THRESHOLD }} \
+            --lines ${{ env.COVERAGE_THRESHOLD }}
+
+      - name: "Download all test result artifacts"
+        uses: actions/download-artifact@v8
+        if: always()
+        with:
+          pattern: test-results-shard-*
+          path: test-results
+          merge-multiple: false
+
+      - name: "Aggregate test results"
+        if: always()
+        id: test-results
+        run: |
+          node -e "
+          const fs = require('fs');
+          const path = require('path');
+
+          const resultsDir = 'test-results';
+          const dirs = fs.readdirSync(resultsDir).filter(d =>
+            d.startsWith('test-results-shard-')
+          );
+
+          const totals = {
+            numTotalTests: 0,
+            numPassedTests: 0,
+            numFailedTests: 0,
+            numPendingTests: 0,
+            numTotalTestSuites: 0,
+            startTime: Infinity,
+            endTime: 0,
+            success: true,
+          };
+
+          for (const dir of dirs) {
+            const filePath = path.join(resultsDir, dir, 'test-results.json');
+            const data = JSON.parse(fs.readFileSync(filePath, 'utf8'));
+            totals.numTotalTests += data.numTotalTests;
+            totals.numPassedTests += data.numPassedTests;
+            totals.numFailedTests += data.numFailedTests;
+            totals.numPendingTests += data.numPendingTests;
+            totals.numTotalTestSuites += data.numTotalTestSuites;
+            totals.startTime = Math.min(totals.startTime, data.startTime);
+            if (data.testResults && data.testResults.length > 0) {
+              const latest = data.testResults.reduce(function (max, r) { return Math.max(max, r.endTime || 0); }, 0);
+              totals.endTime = Math.max(totals.endTime, latest);
+            }
+            if (!data.success) totals.success = false;
+          }
+
+          const durationSec = ((totals.endTime - totals.startTime) / 1000).toFixed(1);
+
+          const summary = [
+            '## Unit Test Results',
+            '',
+            '| Total Tests | Passed | Failed | Skipped | Test Suites | Duration |',
+            '|-------------|--------|--------|---------|-------------|----------|',
+            '| ' + totals.numTotalTests + ' | ' + totals.numPassedTests + ' | ' + totals.numFailedTests + ' | ' + totals.numPendingTests + ' | ' + totals.numTotalTestSuites + ' | ' + durationSec + 's |',
+            '',
+            totals.success ? ':white_check_mark: All tests passed' : ':x: Some tests failed',
+          ].join('\n');
+
+          const delimiter = 'EOF_' + Date.now();
+
+          fs.appendFileSync(process.env.GITHUB_OUTPUT,
+            'summary<<' + delimiter + '\n' + summary + '\n' + delimiter + '\n'
+          );
+          "
+
+      - name: "Capture coverage summary"
+        id: coverage-summary
+        if: always() && needs.build-test.result == 'success'
+        run: |
+          export COVERAGE_OUTPUT=$(npx nyc report --temp-dir .nyc_output --reporter=text-summary 2>&1 || true)
+
+          node -e "
+          const fs = require('fs');
+          const output = process.env.COVERAGE_OUTPUT;
+          const threshold = Number(process.env.COVERAGE_THRESHOLD);
+          const lines = output.split('\n');
+          const rows = [];
+
+          for (const line of lines) {
+            const match = line.match(/^(Statements|Branches|Functions|Lines)\s*:\s*([\d.]+%)\s*\(\s*(\d+)\/(\d+)\s*\)/);
+            if (match) {
+              rows.push({ metric: match[1], percent: match[2], covered: match[3], total: match[4] });
+            }
+          }
+
+          const table = [
+            '| Metric | Coverage | Covered | Total | Threshold |',
+            '|--------|----------|---------|-------|-----------|',
+          ];
+
+          for (const row of rows) {
+            const pctNum = parseFloat(row.percent);
+            const icon = pctNum >= threshold ? ':white_check_mark:' : ':x:';
+            table.push('| ' + icon + ' ' + row.metric + ' | ' + row.percent + ' | ' + row.covered + ' | ' + row.total + ' | ' + threshold + '% |');
+          }
+
+          const result = table.join('\n');
+          const delimiter = 'EOF_' + Date.now();
+
+          fs.appendFileSync(process.env.GITHUB_OUTPUT,
+            'text<<' + delimiter + '\n' + result + '\n' + delimiter + '\n'
+          );
+          "
+
+      - name: "Post results to PR"
+        if: always() && github.event_name == 'pull_request'
+        uses: actions/github-script@v7
+        env:
+          TEST_SUMMARY: ${{ steps.test-results.outputs.summary }}
+          COVERAGE_TEXT: ${{ steps.coverage-summary.outputs.text }}
+        with:
+          script: |
+            const testSummary = process.env.TEST_SUMMARY;
+            const coverageText = process.env.COVERAGE_TEXT;
+
+            const body = [
+              testSummary,
+              '',
+              '## Coverage Summary',
+              '',
+              coverageText,
+              '',
+              '---',
+              `*Generated from [workflow run](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId})*`,
+            ].join('\n');
+
+            const marker = '<!-- unit-test-coverage-comment -->';
+            const fullBody = marker + '\n' + body;
+
+            const { data: comments } = await github.rest.issues.listComments({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              issue_number: context.issue.number,
+              per_page: 100,
+            });
+
+            const existing = comments.find(c => c.body && c.body.includes(marker));
+
+            if (existing) {
+              await github.rest.issues.updateComment({
+                owner: context.repo.owner,
+                repo: context.repo.repo,
+                comment_id: existing.id,
+                body: fullBody,
+              });
+            } else {
+              await github.rest.issues.createComment({
+                owner: context.repo.owner,
+                repo: context.repo.repo,
+                issue_number: context.issue.number,
+                body: fullBody,
+              });
+            }
+
+      - name: "Write results to Job Summary"
+        if: always()
+        env:
+          TEST_SUMMARY: ${{ steps.test-results.outputs.summary }}
+          COVERAGE_TEXT: ${{ steps.coverage-summary.outputs.text }}
+        run: |
+          echo "${TEST_SUMMARY}" >> $GITHUB_STEP_SUMMARY
+          echo "" >> $GITHUB_STEP_SUMMARY
+          echo "## Coverage Summary" >> $GITHUB_STEP_SUMMARY
+          echo "" >> $GITHUB_STEP_SUMMARY
+          echo "${COVERAGE_TEXT}" >> $GITHUB_STEP_SUMMARY
diff --git a/.storybook/stories/PayPalCheckoutV6/EditSavedPayment.stories.ts b/.storybook/stories/PayPalCheckoutV6/EditSavedPayment.stories.ts
