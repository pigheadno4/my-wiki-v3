+      jest.spyOn(document, "hidden", "get").mockReturnValue(undefined);
+      Object.defineProperty(document, "webkitHidden", {
+        configurable: true,
+        get: () => true,
+      });
+
+      expect(isDocumentHidden()).toBe(true);
+
+      delete document.webkitHidden;
+    });
+  });
+});
