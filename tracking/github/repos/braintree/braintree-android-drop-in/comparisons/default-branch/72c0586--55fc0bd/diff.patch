+// freemarker into its doc-generation plugin classpath. Declaring them
+// directly on the dokkaPlugin configuration lets Gradle's normal
+// highest-version-wins resolution pick these up instead, without forcing
+// versions across every configuration in the build.
+dependencies {
+    dokkaPlugin 'org.jsoup:jsoup:1.23.1'
+    dokkaPlugin 'org.freemarker:freemarker:2.3.35'
+}
