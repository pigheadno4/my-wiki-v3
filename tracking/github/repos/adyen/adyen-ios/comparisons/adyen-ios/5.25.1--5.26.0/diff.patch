+    /// Expected security code (CVC/CVV) length: 4 for Amex, 3 for any other or undetected brand.
+    internal var expectedSecurityCodeLength: Int {
+        self?.expectedSecurityCodeLength ?? CardType.Constants.generalLength
+    }
+}
