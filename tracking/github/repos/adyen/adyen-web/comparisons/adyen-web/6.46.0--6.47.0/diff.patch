+        const AttachedComponent = () => {
+            const ref = useAutoFocus();
+            return (
+                <button
+                    type="button"
+                    ref={element => {
+                        ref.current = element;
+                    }}
+                >
+                    Focus me
+                </button>
+            );
+        };
+
