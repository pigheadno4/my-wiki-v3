+  # is the one that actually consumes ReactNativeHost.h — and it's the
+  # *consumer's* CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES
+  # setting, not ReactNativeHost's own, that determines whether Xcode 27's
+  # dependency scanner errors when precompiling ReactNativeHost's module for
+  # this project. Apply the same fix here.
+  project.targets.each do |target|
+    target.build_configurations.each do |config|
+      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
+    end
+  end
+
   project.save
 end
