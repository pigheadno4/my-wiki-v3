index 0000000..aad7c42
--- /dev/null
+++ b/.hark/changes/2022-11-04_anniel_remove-deprecated-basic.change.md
@@ -0,0 +1,37 @@
+---
+title: Remove deprecated basic method definitions.
+pr_url: https://github.com/stripe/stripe-node/pull/1600
+semver_level: major
+section: ⚠️ Removed
+released_in_version: 11.0.0
+---
+
+Use basic methods defined on the resource instead.
+```typescript
+// Before
+basicMethods: true
+
+// After
+create: stripeMethod({
+  method: 'POST',
+  fullPath: '/v1/resource',
+}),
+list: stripeMethod({
+  method: 'GET',
+  methodType: 'list',
+  fullPath: '/v1/resource',
+}),
+retrieve: stripeMethod({
+  method: 'GET',
+  fullPath: '/v1/resource/{id}',
+}),
+update: stripeMethod({
+  method: 'POST',
+  fullPath: '/v1/resource/{id}',
+}),
+// Avoid 'delete' keyword in JS
+del: stripeMethod({
+  method: 'DELETE',
+  fullPath: '/v1/resource/{id}',
+}),
+```
