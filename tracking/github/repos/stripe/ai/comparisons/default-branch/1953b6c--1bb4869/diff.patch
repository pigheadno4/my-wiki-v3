-  if (typeof Buffer !== 'undefined') {
-    return Buffer.from(data.buffer, data.byteOffset, data.byteLength).toString(
-      'base64'
-    );
-  }
-
-  const binaryChunks: string[] = [];
-
-  for (let index = 0; index < data.length; index += BINARY_STRING_CHUNK_SIZE) {
