index 0000000..f2f8453
--- /dev/null
+++ b/providers/claude/plugin/scripts/feedback.mjs
@@ -0,0 +1,165 @@
+export const FEEDBACK_CRITERIA_SENTENCE =
+  'Stripe aims to make powerful, intuitive, and delightful products; it should be easy to infer the right way of doing things. ' +
+  'We enthusiastically encourage agents to give us feedback when we fall short (or do surprisingly well). ' +
+  'Good feedback is "ticket-ready": include reproduction steps, desired vs observed behavior, and what was surprisingly good or bad. ' +
+  "Make sure to explain the user's underlying goal and context: understanding the problem behind the problem may help us identify a better strategy altogether.";
+export const FEEDBACK_COMMAND_EXAMPLE_SENTENCE =
+  'For example: `stripe feedback --json --sentiment neutral ' +
+  '--message "..." ' +
+  '--context "..." ' +
+  '--feature docs`.';
+export const FEEDBACK_OPTIONS_SENTENCE =
+  'Use positive, neutral, or negative honestly. Set `--feature` to the ' +
+  'affected product area; use `skills` for skill feedback or `other` when ' +
+  'none fits. `stripe feedback --help` lists every option.';
+export const USER_APPROVAL_SENTENCE =
+  'Before submitting, show the prospective feedback to the user and ask for approval, ' +
+  'mentioning that they may be invited to a private beta if Stripe is developing a solution to their problem.';
+export const CONTINUE_USER_TASK_SENTENCE =
+  "Then continue the user's task.";
+export const CONTINUE_WITH_NEW_MESSAGE_SENTENCE =
+  "Then continue by responding to the user's new message.";
+
+export const PER_BATCH_FEEDBACK_MESSAGE = composeFeedbackMessage(
+  'Assess the Stripe skills, MCP tools, or APIs used in this batch.',
+  FEEDBACK_CRITERIA_SENTENCE,
+  FEEDBACK_COMMAND_EXAMPLE_SENTENCE,
+  FEEDBACK_OPTIONS_SENTENCE,
+  CONTINUE_USER_TASK_SENTENCE,
+  USER_APPROVAL_SENTENCE,
+);
+
+export const TOOL_FAILURE_FEEDBACK_MESSAGE = composeFeedbackMessage(
+  'The Stripe tool failed.',
+  FEEDBACK_CRITERIA_SENTENCE,
+  FEEDBACK_COMMAND_EXAMPLE_SENTENCE,
+  FEEDBACK_OPTIONS_SENTENCE,
+  'Then continue resolving the failure and the user\'s task.',
+  USER_APPROVAL_SENTENCE,
+);
+
+export const AGENT_FEEDBACK_MESSAGE = composeFeedbackMessage(
+  "Assess the completed subagent's Stripe-related work.",
+  FEEDBACK_CRITERIA_SENTENCE,
+  FEEDBACK_COMMAND_EXAMPLE_SENTENCE,
+  FEEDBACK_OPTIONS_SENTENCE,
+  CONTINUE_USER_TASK_SENTENCE,
+  USER_APPROVAL_SENTENCE,
+);
+
+export const PER_TURN_FEEDBACK_MESSAGE = composeFeedbackMessage(
+  'Assess the preceding Stripe work before handling the new message.',
+  FEEDBACK_CRITERIA_SENTENCE,
+  FEEDBACK_COMMAND_EXAMPLE_SENTENCE,
+  FEEDBACK_OPTIONS_SENTENCE,
+  CONTINUE_WITH_NEW_MESSAGE_SENTENCE,
+  USER_APPROVAL_SENTENCE,
+);
+
+export function composeFeedbackMessage(...sentences) {
+  return sentences.filter(Boolean).join('\n\n');
+}
+
+export function isStripeToolCall(event, argumentsValue) {
+  const toolName = event?.tool_name;
+
+  if (
+    typeof toolName === 'string' &&
+    (toolName.startsWith('mcp__plugin_stripe_stripe__') ||
+      toolName.startsWith('mcp__stripe__'))
+  ) {
+    return true;
+  }
+
+  return getStripeSkillName(event, argumentsValue) !== undefined;
+}
+
+export function batchIncludesStripeTool(event) {
+  return batchToolCalls(event).some((call) =>
+    isStripeToolCall(call, call.tool_input),
+  );
+}
+
+export function batchIncludesFailedStripeTool(event) {
+  return batchToolCalls(event).some(
+    (call) =>
+      isStripeToolCall(call, call.tool_input) &&
+      toolResponseLooksFailed(call.tool_response),
+  );
+}
+
+export function agentWorkMentions(pattern, event) {
+  return valuesMention(
+    pattern,
+    event.tool_input?.prompt,
+    event.tool_response?.content,
+  );
+}
+
+export function toolWorkMentions(pattern, event) {
+  return valuesMention(
+    pattern,
+    event.tool_name,
+    event.tool_input,
+    event.tool_response,
+    event.error,
+  );
+}
+
+export function batchWorkMentions(pattern, event) {
+  return batchToolCalls(event).some((call) => toolWorkMentions(pattern, call));
+}
+
+export function getStripeSkillName(event, argumentsValue) {
+  const skillName = argumentsValue?.skill;
+  if (
+    event?.tool_name !== 'Skill' ||
+    typeof skillName !== 'string'
+  ) {
+    return undefined;
+  }
+
+  if (skillName.startsWith('stripe:')) {
+    return skillName.slice('stripe:'.length);
+  }
+
+  // Directly installed Metronome skills have no plugin namespace.
+  return skillName.startsWith('metronome-') ? skillName : undefined;
+}
+
+function batchToolCalls(event) {
+  return Array.isArray(event?.tool_calls)
+    ? event.tool_calls.filter(
+        (call) => call && typeof call === 'object',
+      )
+    : [];
+}
+
+function toolResponseLooksFailed(response) {
+  if (Array.isArray(response)) {
+    return response.some(toolResponseLooksFailed);
+  }
+  if (response && typeof response === 'object') {
+    return (
+      response.is_error === true ||
+      response.isError === true ||
+      toolResponseLooksFailed(response.error) ||
+      toolResponseLooksFailed(response.content)
+    );
+  }
+  return (
+    typeof response === 'string' &&
+    /^(?:error\b|exit code \d+\b|mcp error\b|tool use error\b|<tool_use_error>)/i.test(
+      response.trimStart(),
+    )
+  );
+}
+
+function valuesMention(pattern, ...values) {
+  return values.some((value) => {
+    pattern.lastIndex = 0;
+    return pattern.test(
+      typeof value === 'string' ? value : JSON.stringify(value ?? ''),
+    );
+  });
+}
diff --git a/providers/claude/plugin/scripts/feedbackSampling.mjs b/providers/claude/plugin/scripts/feedbackSampling.mjs
new file mode 100644
index 0000000..4165f66
--- /dev/null
+++ b/providers/claude/plugin/scripts/feedbackSampling.mjs
@@ -0,0 +1,101 @@
+import {
+  agentWorkMentions,
+  batchIncludesFailedStripeTool,
+  batchIncludesStripeTool,
+  batchWorkMentions,
+  isStripeToolCall,
+  toolWorkMentions,
+} from './feedback.mjs';
+import { getHookArguments, sample } from './hookHelpers.mjs';
+import { lastTurnMentioned } from './transcriptHelpers.mjs';
+
+// Tune feedback sampling here. Unmatched events use defaultRate; baseRate is
+// only used by matching multiplier rules. The last matching rule wins.
+export const feedbackSampling = {
+  defaultRate: 0,
+  sampleRules: [
+    {
+      matches: ({ checkEvent }) => checkEvent(/stripe/i),
+      multiplier: 1,
+    },
+    {
+      matches: ({ checkEvent }) => checkEvent(/metronome/i),
+      multiplier: 10,
+    },
+    // For testing, append a rule with rate: 1 instead of a multiplier.
+    // Exact rates still respect eventConditions.
+  ],
+  events: {
+    PostToolBatch: {
+      eventConditions: (event) =>
+        batchIncludesStripeTool(event) &&
+        !batchIncludesFailedStripeTool(event),
+      baseRate: 0.001,
+      checkEvent: batchWorkMentions,
+    },
+    PostToolUse: {
+      eventConditions: (event) =>
+        event.tool_name === 'Agent' &&
+        event.tool_response?.status === 'completed',
+      baseRate: 0.001,
+      checkEvent: agentWorkMentions,
+    },
+    PostToolUseFailure: {
+      eventConditions: (event) =>
+        isStripeToolCall(event, getHookArguments(event)),
+      baseRate: 1,
+      checkEvent: toolWorkMentions,
+    },
+    UserPromptSubmit: {
+      baseRate: 0.01,
+      checkEvent: lastTurnMentioned,
+    },
+  },
+};
+
+export function feedbackSampleRate(
+  eventName,
+  event,
+  config = feedbackSampling,
+) {
+  const policy = Object.hasOwn(config.events, eventName)
+    ? config.events[eventName]
+    : undefined;
+  if (!policy || (policy.eventConditions && !policy.eventConditions(event))) {
+    return 0;
+  }
+
+  const context = {
+    event,
+    checkEvent: (pattern) => policy.checkEvent(pattern, event),
+  };
+  let rate = config.defaultRate;
+  // Optional event rules run after shared rules, so they take precedence.
+  for (const rule of [
+    ...config.sampleRules,
+    ...(policy.sampleRules ?? []),
+  ]) {
+    if (!rule.matches(context)) {
+      continue;
+    }
+    const hasRate = Object.hasOwn(rule, 'rate');
+    const hasMultiplier = Object.hasOwn(rule, 'multiplier');
+    if (hasRate === hasMultiplier) {
+      throw new Error('Sampling rules must specify either rate or multiplier');
+    }
+    const value = hasRate ? rule.rate : rule.multiplier;
+    if (!Number.isFinite(value) || value < 0 || (hasRate && value > 1)) {
+      throw new Error('Invalid feedback sampling rule');
+    }
+    rate = hasRate ? value : Math.min(1, policy.baseRate * value);
+  }
+  if (!Number.isFinite(rate) || rate < 0 || rate > 1) {
+    throw new Error('Invalid feedback sampling rate');
+  }
+  return rate;
+}
+
+export function shouldSampleFeedback(eventName, event, random = Math.random) {
+  const rate = feedbackSampleRate(eventName, event);
+  return rate > 0 && sample(rate, random);
+}
diff --git a/providers/claude/plugin/scripts/hookHelpers.mjs b/providers/claude/plugin/scripts/hookHelpers.mjs
new file mode 100644
index 0000000..15795e4
--- /dev/null
+++ b/providers/claude/plugin/scripts/hookHelpers.mjs
@@ -0,0 +1,66 @@
+export async function readHookEvent(input = process.stdin) {
+  const chunks = [];
+  for await (const chunk of input) {
+    chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
+  }
+
+  const rawEvent = Buffer.concat(chunks).toString('utf8').trim();
+  if (!rawEvent) {
+    throw new Error('Hook event input is empty');
+  }
+
+  const event = JSON.parse(rawEvent);
+  if (event === null || Array.isArray(event) || typeof event !== 'object') {
+    throw new Error('Hook event must be a JSON object');
+  }
+  return event;
+}
+
+export function getHookArguments(event) {
+  const argumentsValue = event?.tool_input;
+  return argumentsValue !== null &&
+    !Array.isArray(argumentsValue) &&
+    typeof argumentsValue === 'object'
+    ? argumentsValue
+    : {};
+}
+
+export function sample(rate, random = Math.random) {
+  return random() < rate;
+}
+
+function isTruthyFlag(value) {
+  return value === '1' || /^true$/i.test(value ?? '');
+}
+
+export function isTelemetryDisabled(env = process.env) {
+  return isTruthyFlag(env.DISABLE_TELEMETRY) || isTruthyFlag(env.DO_NOT_TRACK);
+}
+
+export function emitSoftContext(hookEventName, message) {
+  process.stdout.write(
+    JSON.stringify({
+      hookSpecificOutput: {
+        hookEventName,
+        additionalContext: message,
+      },
+    }),
+  );
+}
+
+export function emitHardSteer(message) {
+  process.stdout.write(
+    JSON.stringify({
+      decision: 'block',
+      reason: message,
+    }),
+  );
+}
+
+export async function runHook(callback) {
+  try {
+    await callback();
+  } catch {
+    // Feedback guidance must never interrupt the agent's work.
+  }
+}
