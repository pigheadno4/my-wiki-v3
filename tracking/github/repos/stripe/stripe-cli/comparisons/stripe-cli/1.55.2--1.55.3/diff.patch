+		for _, r := range rows {
+			if len(r.name) > nameW {
+				nameW = len(r.name)
+			}
+			if len(r.id) > idW {
+				idW = len(r.id)
+			}
+		}
+	}
+	for _, rows := range grouped.headerRows {
+		measure(rows)
+	}
+	for _, rows := range grouped.childRows {
