+    -H "Authorization: Bearer $GITHUB_TOKEN" \
+    -H "Accept: application/vnd.github+json" \
+    https://api.github.com/repos/stripe/react-stripe-js 2>&1) || true
+  local status_line
+  status_line=$(grep -iE '^HTTP/' <<< "$sso_headers" | tail -n 1 | tr -d '\r')
+  if grep -qiE '^x-github-sso: *required' <<< "$sso_headers"; then
+    local sso_url
+    sso_url=$(grep -iE '^x-github-sso:' <<< "$sso_headers" | sed -nE 's/.*url=([^;[:space:]]+).*/\1/p' | tr -d '\r')
+    echo "Error! GITHUB_TOKEN is not authorized for stripe's SAML SSO ($status_line)."
